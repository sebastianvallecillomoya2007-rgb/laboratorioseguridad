NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional locally. In production, set a separate random 32-byte base64 key.
ENCRYPTION_KEY=
# MySQL connection. Keep the password only in .env or the host's secret manager.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=securevault
DB_PASSWORD=replace-with-your-local-mysql-password
# Optional: creates an administrator on first startup if the email is new.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional production password reset delivery webhook.
RESET_WEBHOOK_URL=
RESET_WEBHOOK_TOKEN=
# Set to the number of trusted reverse proxies only when required by the host.
TRUST_PROXY=
